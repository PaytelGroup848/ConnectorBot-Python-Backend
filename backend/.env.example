# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Connector AI Assistant"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/connector_ai_db
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/connector_ai_db

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Gateway Configuration
AI_GATEWAY_BASE_URL=https://patwatoliai.com/v1
AI_API_KEY=your_patwatoliai_api_key_here
AI_DEFAULT_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Existing Connector Platform Integration
CONNECTOR_API_BASE_URL=https://connector.cloudata.in/api
CONNECTOR_TIMEOUT_SECONDS=10

